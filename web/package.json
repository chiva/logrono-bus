{
  "name": "logrono-bus-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": "v26.13.0"
  },
  "scripts": {
    "gen:types": "openapi-typescript ../contracts/openapi.json --output packages/core/src/types.gen.ts && prettier --write packages/core/src/types.gen.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "pnpm --filter @logrono-bus/pwa dev",
    "build": "pnpm --filter @logrono-bus/pwa --filter @logrono-bus/ha-card build",
    "e2e": "pnpm --filter @logrono-bus/pwa e2e",
    "screenshots": "pnpm --filter @logrono-bus/pwa screenshots"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
