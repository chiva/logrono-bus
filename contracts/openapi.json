  "info": {
    "description": "\nEstimaciones de paso de los autobuses urbanos de Logroño, normalizadas y con caché compartida.\n\n**Proyecto no oficial.** Los datos proceden del servicio web público del Ayuntamiento de Logroño;\neste servicio solo los reorganiza y limita la frecuencia de consulta.\n",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Logroño Bus API",
    "version": "0.5.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/board": {
      "get": {
        "description": "Lo mismo que muestra la web: una tarjeta por línea y sentido, con sus próximas llegadas.",
        "operationId": "board_api_v1_board_get",
        "parameters": [
          {
            "description": "Selección del panel (como en la URL de la web), p. ej. `101-2d.5a~100-2a`",
            "in": "query",
            "name": "p",
            "required": true,
            "schema": {
              "description": "Selección del panel (como en la URL de la web), p. ej. `101-2d.5a~100-2a`",
              "examples": [
                "101-2d.5a~100-2a"
              ],
              "title": "P",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 3,
              "maximum": 10,
              "minimum": 0,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "`text` para widgets de texto",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/BoardFormat",
              "default": "json",
              "description": "`text` para widgets de texto"
            }
          },
          {
            "description": "`seleccion` (como en `p`), `linea` (por número) o `llegada` (la primera)",
            "in": "query",
            "name": "orden",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CardOrder",
              "default": "seleccion",
              "description": "`seleccion` (como en `p`), `linea` (por número) o `llegada` (la primera)"
            }
          },
          {
            "description": "Con `format=text`: `minutos` (4, 12 min) o `hora` (18:04, 18:12), que sigue siendo cierta aunque el widget tarde en refrescarse",
            "in": "query",
            "name": "tiempo",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TimeStyle",
              "default": "minutos",
              "description": "Con `format=text`: `minutos` (4, 12 min) o `hora` (18:04, 18:12), que sigue siendo cierta aunque el widget tarde en refrescarse"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Board"
                }
              },
              "text/plain": {}
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Selección no válida"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Parada o línea inexistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Parámetros no válidos"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "El servicio del Ayuntamiento ha cambiado de formato"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "El servicio del Ayuntamiento no responde (ver `Retry-After`)"
          }
        },
        "summary": "Panel: tarjetas de varias paradas",
        "tags": [
          "llegadas"
        ]
      }
    },
    "/api/v1/catalog": {
      "get": {
        "description": "Líneas, sentidos y paradas en una sola respuesta: lo que la web carga al arrancar.",
