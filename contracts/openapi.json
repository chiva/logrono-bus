                }
              }
            },
            "description": "El servicio del Ayuntamiento no responde (ver `Retry-After`)"
          }
        },
        "summary": "Catálogo completo",
        "tags": [
          "catálogo"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Versión, versión de la API y estado del origen. La web lo usa para detectar el servidor.",
        "operationId": "health_api_v1_health_get",
